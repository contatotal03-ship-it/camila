/* ═══════════════════════════════════════════════════════════════════
   PREMIUM DARK THEME — Conciliador Financiero
   ═══════════════════════════════════════════════════════════════════ */

/* ── Global ──────────────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "Segoe UI Variable", "Inter", sans-serif;
}

QMainWindow {
    background-color: #0f1923;
    color: #e0e6ed;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */
#Sidebar {
    background-color: #0b1219;
    border-right: 1px solid #1a2736;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #8899a6;
    text-align: left;
    padding: 16px 22px;
    font-size: 14px;
    font-weight: 500;
    border: none;
    border-left: 3px solid transparent;
    border-bottom: 1px solid #131e29;
    letter-spacing: 0.3px;
}

#Sidebar QPushButton:hover {
    background-color: #121e2b;
    color: #e0e6ed;
    border-left-color: #1e3a5f;
}

#Sidebar QPushButton:checked {
    background-color: linear-gradient(135deg, #0d2137, #122a45);
    background-color: #0f253d;
    color: #4fc3f7;
    border-left: 3px solid #4fc3f7;
    font-weight: 600;
}

#Sidebar QLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    padding: 12px 10px;
    letter-spacing: 0.5px;
}

/* ── Main Content ────────────────────────────────────────────────── */
#MainContent {
    background-color: #0f1923;
    border-radius: 0px;
    margin: 0px;
}

/* ── General Labels ──────────────────────────────────────────────── */
QLabel {
    color: #c5d0d9;
    font-size: 14px;
}

QLabel#TitleLabel {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 4px;
    letter-spacing: -0.3px;
}

QLabel#SubtitleLabel {
    color: #5c7a8a;
    font-size: 13px;
    font-weight: 400;
    margin-bottom: 8px;
    letter-spacing: 0.2px;
}

/* ── Primary Button (Accented) ──────────────────────────────────── */
QPushButton.PrimaryButton {
    background-color: #1565c0;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1565c0, stop:1 #1976d2);
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    padding: 12px 28px;
    border: none;
    letter-spacing: 0.4px;
}

QPushButton.PrimaryButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1976d2, stop:1 #2196f3);
}

QPushButton.PrimaryButton:pressed {
    background-color: #0d47a1;
}

QPushButton.PrimaryButton:disabled {
    background-color: #1a2736;
    color: #3d5060;
}

/* ── Secondary Button ────────────────────────────────────────────── */
QPushButton.SecondaryButton {
    background-color: #152030;
    color: #7fb3d3;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
    padding: 10px 20px;
    border: 1px solid #1e3a5f;
    letter-spacing: 0.3px;
}

QPushButton.SecondaryButton:hover {
    background-color: #1a2a40;
    color: #a8d4f0;
    border-color: #2a5580;
}

QPushButton.SecondaryButton:pressed {
    background-color: #0f1a28;
}

QPushButton.SecondaryButton:disabled {
    background-color: #0f1520;
    color: #2d3e4e;
    border-color: #1a2530;
}

/* ── Line Edit (Input Fields) ────────────────────────────────────── */
QLineEdit {
    background-color: #111d29;
    color: #c5d0d9;
    border: 1px solid #1e3040;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    selection-background-color: #1565c0;
}

QLineEdit:focus {
    border: 1px solid #1976d2;
    background-color: #131f2e;
}

QLineEdit:read-only {
    background-color: #0c1520;
    color: #5a7080;
    border: 1px solid #162030;
}

/* ── Text Edit (Results / Log) ──────────────────────────────────── */
#ResultText {
    background-color: #0b1219;
    color: #b0c4d4;
    border: 1px solid #1a2736;
    border-radius: 10px;
    padding: 14px;
    font-family: "Cascadia Code", "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    line-height: 1.5;
    selection-background-color: #1565c0;
}

/* ── Cards / Frames ──────────────────────────────────────────────── */
.CardFrame {
    background-color: #111d29;
    border: 1px solid #1a2736;
    border-radius: 12px;
    padding: 20px;
}

.CardFrame:hover {
    border-color: #1e3a5f;
}

.KpiCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #111d29, stop:1 #0e1824);
    border: 1px solid #1a2736;
    border-radius: 12px;
    padding: 18px;
}

.KpiCard:hover {
    border-color: #2a5580;
}

/* ── Section Headers ─────────────────────────────────────────────── */
.SectionHeader {
    color: #4fc3f7;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 4px 0px;
}

/* ── Separator Lines ─────────────────────────────────────────────── */
QFrame[frameShape="4"] {
    color: #1e3040;
    max-height: 1px;
    margin: 4px 0px;
}

/* ── Dialog ──────────────────────────────────────────────────────── */
QDialog {
    background-color: #0f1923;
    color: #c5d0d9;
}

QTabWidget::pane {
    border: 1px solid #1a2736;
    border-radius: 8px;
    background-color: #111d29;
    top: -1px;
}

QTabBar::tab {
    background-color: #0c1520;
    color: #5c7a8a;
    border: 1px solid #1a2736;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 500;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #111d29;
    color: #4fc3f7;
    font-weight: 600;
    border-bottom: 2px solid #4fc3f7;
}

QTabBar::tab:hover:!selected {
    background-color: #152030;
    color: #7fb3d3;
}

QPlainTextEdit {
    background-color: #0c1520;
    color: #c5d0d9;
    border: 1px solid #1a2736;
    border-radius: 6px;
    padding: 8px;
    font-family: "Cascadia Code", Consolas, monospace;
    font-size: 12px;
    selection-background-color: #1565c0;
}

/* ── Message Box ─────────────────────────────────────────────────── */
QMessageBox {
    background-color: #111d29;
    color: #c5d0d9;
}

/* ── Scrollbar ───────────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #0b1219;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #1e3040;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2a4560;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0b1219;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #1e3040;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2a4560;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Tooltips ────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a2736;
    color: #c5d0d9;
    border: 1px solid #2a4560;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
